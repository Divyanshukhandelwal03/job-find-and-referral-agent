# Server Configuration
PORT=5050
NODE_ENV=development

# Google Gemini AI API Key
# >>> INSERT YOUR GEMINI API KEY HERE <<<
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Local Storage Directories (auto-created on startup)
DATA_DIR=./data
UPLOADS_DIR=./data/uploads

# Optional: Google OAuth Credentials for Gmail Sending
# Note: You can also connect your personal Gmail using a Google App Password directly in the Settings UI.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
